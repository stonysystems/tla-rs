// Mode annotations for Vpaxos.rs
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module Vpaxos {
    LInit(-, +);  // s is output (initialized state), c is input (constants)
    LPrepare(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), b is input, sent_packets is input
    LSendPromise(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), prepare_bal is input, sent_packets is input
    LReceivePromise(+, -, +, +, +, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), sender is input, promise_bal is input, promise_v_bal is input, promise_val is input, sent_packets is input
    LAccept(+, -, +, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), b is input, v is input, sent_packets is input
    LReceiveAccepted(+, -, +, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), sender is input, accept_bal is input, sent_packets is input
    LCommit(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), sent_packets is input
    LReconfigure(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), sent_packets is input
    LWitnessSync(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), witness_val is input, sent_packets is input
    LSync(+, -, +, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), new_config is input, val is input, sent_packets is input
    LDeactivate(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), sent_packets is input
    LNext(+, -, +);  // s is input (current state), s_ is output (next state), c is input (constants)
}
