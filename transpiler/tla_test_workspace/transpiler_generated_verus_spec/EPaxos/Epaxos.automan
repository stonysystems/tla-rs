// Mode annotations for Epaxos.rs
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module Epaxos {
    LInit(-, +);  // s is output (initialized state), c is input (constants)
    LPropose(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), value is input, sent_packets is input
    LSendPreAcceptOk(+, -, +, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), local_conflict is input, local_seq is input, sent_packets is input
    LReceivePreAcceptOk(+, -, +, +, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), pa_sender is input, pa_seq is input, pa_conflict is input, sent_packets is input
    LFastCommit(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), sent_packets is input
    LStartAccept(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), sent_packets is input
    LSendAcceptOk(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), sent_packets is input
    LReceiveAcceptOk(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), ao_sender is input, sent_packets is input
    LSlowCommit(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), sent_packets is input
    LExecute(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), sent_packets is input
    LRecover(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), new_ballot is input, sent_packets is input
    LNewInstance(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), sent_packets is input
    LNext(+, -, +);  // s is input (current state), s_ is output (next state), c is input (constants)
}
