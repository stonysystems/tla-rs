// Mode annotations for Twophase.rs
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module Twophase {
    LInit(-, +);  // s is output (initialized state), c is input (constants)
    LTMSendPrepare(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), sent_packets is input
    LRMReceivePrepare(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), rm is input, sent_packets is input
    LRMAbort(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), rm is input, sent_packets is input
    LTMRcvPrepared(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), r is input, sent_packets is input
    LTMSendCommit(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), sent_packets is input
    LTMSendAbort(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), sent_packets is input
    LRMReceiveCommit(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), rm is input, sent_packets is input
    LRMReceiveAbort(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), rm is input, sent_packets is input
    LNext(+, -, +);  // s is input (current state), s_ is output (next state), c is input (constants)
}
