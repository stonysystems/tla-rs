// Mode annotations for Paxos.rs
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module Paxos {
    LInit(-, +);  // s is output (initialized state), c is input (constants)
    LSend1a(+, +, +, +);  // s is input (state to check), c is input (constants), s_ is input, b is input
    LSend1b(+, +, +, +);  // s is input (state to check), c is input (constants), s_ is input, b is input
    LRecvPromise(+, +, +, +, +, +);  // s is input (state to check), c is input (constants), s_ is input, a is input, a_accepted_bal is input, a_accepted_val is input
    LSend2a(+, +, +, +);  // s is input (state to check), c is input (constants), s_ is input, v is input
    LSend2b(+, +, +, +, +);  // s is input (state to check), c is input (constants), s_ is input, b is input, v is input
    LRecvAccepted(+, +, +, +);  // s is input (state to check), c is input (constants), s_ is input, a is input
    LLearn(+, +, +);  // s is input (state to check), c is input (constants), s_ is input
    LNext(+, +, +);  // s is input (state to check), c is input (constants), s_ is input
}
