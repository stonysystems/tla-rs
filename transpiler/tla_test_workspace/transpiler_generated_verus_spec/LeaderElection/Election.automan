// Mode annotations for Election.rs
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module Election {
    LInit(-, +);  // s is output (initialized state), c is input (constants)
    LDetectFailure(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), node is input, sent_packets is input
    LStartElection(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), node is input, sent_packets is input
    LSendAnswer(+, -, +, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), node is input, sender is input, sent_packets is input
    LReceiveAnswer(+, -, +, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), node is input, responder is input, sent_packets is input
    LSendCoordinator(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), node is input, sent_packets is input
    LReceiveCoordinator(+, -, +, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), node is input, leader is input, sent_packets is input
    LNodeFail(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), node is input, sent_packets is input
    LNext(+, -, +);  // s is input (current state), s_ is output (next state), c is input (constants)
}
