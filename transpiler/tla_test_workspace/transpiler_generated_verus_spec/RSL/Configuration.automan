// Mode annotations for Configuration.rs
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module Configuration {
    helper LConfiguration(+);  // c is input (constants)
    LMinQuorumSize(+);  // c is input (constants)
    LReplicasDistinct(+, +, +, +);  // c is input (constants), replica_ids is input, i is input, j is input
    LReplicasIsUnique(+, +);  // c is input (constants), replica_ids is input
    LWellFormedLConfiguration(+);  // c is input (constants)
    LIsReplicaIndex(+, +, +);  // c is input (constants), idx is input, id is input
    LGetReplicaIndex(+, +);  // c is input (constants), id is input
}
