// Mode annotations for Learner.rs
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module Learner {
    helper LLearner(+);  // c is input (constants)
    LLearnerInit(+, +);  // c is input (constants), l is input
    LLearnerProcess2b(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), packet is input
    LLearnerForgetDecision(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), opn is input
    LLearnerForgetOperationsBefore(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), ops_complete is input
}
