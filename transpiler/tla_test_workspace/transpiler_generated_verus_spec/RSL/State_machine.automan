// Mode annotations for State_machine.rs
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module State_machine {
    LHandleRequest(+, +, +);  // c is input (constants), state is input, request is input
    helper LHandleRequestBatchHidden(+, +, +);  // c is input (constants), state is input, batch is input
    LHandleRequestBatch(+, +, +);  // c is input (constants), state is input, batch is input
}
