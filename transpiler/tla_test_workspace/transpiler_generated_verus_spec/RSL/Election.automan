// Mode annotations for Election.rs
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module Election {
    helper LElectionState(+);  // c is input (constants)
    helper LComputeSuccessorView(+, +);  // c is input (constants), b is input
    LBoundRequestSequence(+, +, +);  // c is input (constants), s is input, lengthBound is input
    LRequestsMatch(+, +, +);  // c is input (constants), r1 is input, r2 is input
    LRequestSatisfiedBy(+, +, +);  // c is input (constants), r1 is input, r2 is input
    helper LRemoveAllSatisfiedRequestsInSequence(+, +, +);  // c is input (constants), s is input, r is input
    LElectionStateInit(+, +);  // c is input (constants), es is input
    LElectionStateProcessHeartbeat(+, +, +, +, +);  // c is input (constants), es is input, es_ is input, p is input, clock is input
    LElectionStateCheckForViewTimeout(+, +, +, +);  // c is input (constants), es is input, es_ is input, clock is input
    LElectionStateCheckForQuorumOfViewSuspicions(+, +, +, +);  // c is input (constants), es is input, es_ is input, clock is input
    LElectionStateReflectReceivedRequest(+, +, +, +);  // c is input (constants), es is input, es_ is input, req is input
    LRemoveExecutedRequestBatch(+, +, +);  // c is input (constants), reqs is input, batch is input
    LElectionStateReflectExecutedRequestBatch(+, +, +, +);  // c is input (constants), es is input, es_ is input, batch is input
}
