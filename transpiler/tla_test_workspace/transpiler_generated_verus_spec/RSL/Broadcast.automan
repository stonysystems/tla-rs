// Mode annotations for Broadcast.rs
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module Broadcast {
    LBroadcastToEveryone(+, +, +, +, +);  // c is input (constants), c is input, myidx is input, m is input, sent_packets is input
    helper LBuildLBroadcast(+, +, +, +);  // c is input (constants), src is input, dsts is input, m is input
}
