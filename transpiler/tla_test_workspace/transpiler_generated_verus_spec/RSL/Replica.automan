// Mode annotations for Replica.rs
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module Replica {
    helper LReplica(+);  // c is input (constants)
    helper LScheduler(+);  // c is input (constants)
    LReplicaInit(+, +);  // c is input (constants), r is input
    LReplicaNextProcessInvalid(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), received_packet is input, sent_packets is input
    LReplicaNextProcessRequest(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), received_packet is input, sent_packets is input
    LReplicaNextProcess1a(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), received_packet is input, sent_packets is input
    LReplicaNextProcess1b(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), received_packet is input, sent_packets is input
    LReplicaNextProcessStartingPhase2(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), received_packet is input, sent_packets is input
    LReplicaNextProcess2a(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), received_packet is input, sent_packets is input
    LReplicaNextProcess2b(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), received_packet is input, sent_packets is input
    LReplicaNextProcessReply(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), received_packet is input, sent_packets is input
    LReplicaNextProcessAppStateSupply(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), received_packet is input, sent_packets is input
    LReplicaNextProcessAppStateRequest(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), received_packet is input, sent_packets is input
    LReplicaNextProcessHeartbeat(+, -, +, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), received_packet is input, clock is input, sent_packets is input
    LReplicaNextSpontaneousMaybeEnterNewViewAndSend1a(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), sent_packets is input
    LReplicaNextSpontaneousMaybeEnterPhase2(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), sent_packets is input
    LReplicaNextReadClockMaybeNominateValueAndSend2a(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), clock is input, sent_packets is input
    LReplicaNextSpontaneousTruncateLogBasedOnCheckpoints(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), sent_packets is input
    LReplicaNextSpontaneousMaybeMakeDecision(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), sent_packets is input
    LReplicaNextSpontaneousMaybeExecute(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), sent_packets is input
    LReplicaNextReadClockMaybeSendHeartbeat(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), clock is input, sent_packets is input
    LReplicaNextReadClockCheckForViewTimeout(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), clock is input, sent_packets is input
    LReplicaNextReadClockCheckForQuorumOfViewSuspicions(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), clock is input, sent_packets is input
    helper LExtractSentPacketsFromIos(+, +);  // c is input (constants), ios is input
    LReplicaNextReadClockAndProcessPacket(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), ios is input
    LReplicaNextProcessPacketWithoutReadingClock(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), ios is input
    LReplicaNextProcessPacket(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), ios is input
    helper LReplicaNumActions(+);  // c is input (constants)
    LSpontaneousIos(+, +, +);  // c is input (constants), ios is input, clocks is input
    helper LSpontaneousClock(+, +);  // c is input (constants), ios is input
    LReplicaNoReceiveNext(+, -, +, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), nextActionIndex is input, ios is input
    LSchedulerInit(+, +);  // c is input (constants), s is input
    LSchedulerNext(+, -, +, +);  // s is input (current state), s_ is output (next state), c is input (constants), ios is input
}
