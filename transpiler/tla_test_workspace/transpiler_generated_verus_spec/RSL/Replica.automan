    LReplicaNextProcess2a(+, +, +, +, +, +);  // s is input (state to check), c is input (constants), s is input, s_ is input, received_packet is input, sent_packets is input
    LReplicaNextProcess2b(+, +, +, +, +, +);  // s is input (state to check), c is input (constants), s is input, s_ is input, received_packet is input, sent_packets is input
    LReplicaNextProcessReply(+, +, +, +, +);  // c is input (constants), s is input, s_ is input, received_packet is input, sent_packets is input
    LReplicaNextProcessAppStateSupply(+, +, +, +, +, +);  // s is input (state to check), c is input (constants), s is input, s_ is input, received_packet is input, sent_packets is input
    LReplicaNextProcessAppStateRequest(+, +, +, +, +);  // c is input (constants), s is input, s_ is input, received_packet is input, sent_packets is input
    LReplicaNextProcessHeartbeat(+, +, +, +, +, +);  // c is input (constants), s is input, s_ is input, received_packet is input, clock is input, sent_packets is input
    LReplicaNextSpontaneousMaybeEnterNewViewAndSend1a(+, +, +, +);  // c is input (constants), s is input, s_ is input, sent_packets is input
    LReplicaNextSpontaneousMaybeEnterPhase2(+, +, +, +);  // c is input (constants), s is input, s_ is input, sent_packets is input
    LReplicaNextReadClockMaybeNominateValueAndSend2a(+, +, +, +, +);  // c is input (constants), s is input, s_ is input, clock is input, sent_packets is input
    LReplicaNextSpontaneousTruncateLogBasedOnCheckpoints(+, +, +, +, +);  // s is input (state to check), c is input (constants), s is input, s_ is input, sent_packets is input
    LReplicaNextSpontaneousMaybeMakeDecision(+, +, +, +, +);  // s is input (state to check), c is input (constants), s is input, s_ is input, sent_packets is input
    LReplicaNextSpontaneousMaybeExecute(+, +, +, +, +);  // s is input (state to check), c is input (constants), s is input, s_ is input, sent_packets is input
    LReplicaNextReadClockMaybeSendHeartbeat(+, +, +, +, +, +);  // s is input (state to check), c is input (constants), s is input, s_ is input, clock is input, sent_packets is input
    LReplicaNextReadClockCheckForViewTimeout(+, +, +, +, +);  // c is input (constants), s is input, s_ is input, clock is input, sent_packets is input
    LReplicaNextReadClockCheckForQuorumOfViewSuspicions(+, +, +, +, +);  // c is input (constants), s is input, s_ is input, clock is input, sent_packets is input
    helper LExtractSentPacketsFromIos(+, +, +);  // s is input (state to check), c is input (constants), ios is input
    LReplicaNextReadClockAndProcessPacket(+, +, +, +, +);  // s is input (state to check), c is input (constants), s is input, s_ is input, ios is input
