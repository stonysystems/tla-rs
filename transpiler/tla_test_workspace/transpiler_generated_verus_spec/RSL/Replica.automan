// Mode annotations for Replica.rs
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module Replica {
    helper LReplica(+);  // c is input (constants)
    helper LScheduler(+);  // c is input (constants)
    LReplicaInit(+, +, +);  // c is input (constants), r is input, c is input
    LReplicaNextProcessInvalid(+, +, +, +, +);  // c is input (constants), s is input, s_ is input, received_packet is input, sent_packets is input
