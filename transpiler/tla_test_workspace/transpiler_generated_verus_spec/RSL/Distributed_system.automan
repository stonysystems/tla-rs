// Mode annotations for Distributed_system.rs
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module Distributed_system {
    helper LRslState(+);  // c is input (constants)
    LRslMapsComplete(+, +);  // c is input (constants), ps is input
    LRslConstantsUnchanged(+, +, +);  // c is input (constants), ps is input, ps_ is input
    LRslInit(+, +, +);  // c is input (constants), con is input, ps is input
    LRslNextCommon(+, +, +);  // c is input (constants), ps is input, ps_ is input
    LRslNextOneReplica(+, +, +, +, +);  // c is input (constants), ps is input, ps_ is input, idx is input, ios is input
    LRslNextEnvironment(+, +, +);  // c is input (constants), ps is input, ps_ is input
    LRslNextOneExternal(+, +, +, +, +);  // c is input (constants), ps is input, ps_ is input, eid is input, ios is input
    LRslNext(+, +, +);  // c is input (constants), ps is input, ps_ is input
}
