// Mode annotations for Distributed_system.rs
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module Distributed_system {
    helper LRslState(+);  // c is input (constants)
    LRslMapsComplete(+, +, +);  // s is input (state to check), c is input (constants), ps is input
    LRslConstantsUnchanged(+, +, +, +);  // s is input (state to check), c is input (constants), ps is input, ps_ is input
    LRslInit(+, +, +, +);  // s is input (state to check), c is input (constants), con is input, ps is input
    LRslNextCommon(+, +, +, +);  // s is input (state to check), c is input (constants), ps is input, ps_ is input
    LRslNextOneReplica(+, +, +, +, +, +);  // s is input (state to check), c is input (constants), ps is input, ps_ is input, idx is input, ios is input
    LRslNextEnvironment(+, +, +, +);  // s is input (state to check), c is input (constants), ps is input, ps_ is input
    LRslNextOneExternal(+, +, +, +, +, +);  // s is input (state to check), c is input (constants), ps is input, ps_ is input, eid is input, ios is input
    LRslNext(+, +, +, +);  // s is input (state to check), c is input (constants), ps is input, ps_ is input
}
