---- MODULE LeaderElection_MC ----
\* Model-checking wrapper for the relational Election spec generated by verus2tla.
\* Adds message channel, VARIABLE state, finite domains, and safety invariants.
\*
\* The generated spec uses relational-style (s, s_, c) parameters with sent_packets
\* output. This wrapper adds explicit message tracking to enable TLC model checking.
\* Models the Bully leader election algorithm.

EXTENDS Integers, Sequences, FiniteSets

\* Finite set of node IDs for model checking
Nodes == {1, 2, 3}

\* State variables
VARIABLE state, constants, msgs

\* Construct the constants record
ConstantsRecord == [nodes |-> Nodes, num_nodes |-> Cardinality(Nodes)]

\* Message types (modeled as tagged records)
\* Election message: a node announces it is starting an election
ElectionMsg(sender) == [type |-> "Election", sender |-> sender]

\* Answer message: a higher-ID node tells a lower-ID node to back down
AnswerMsg(responder) == [type |-> "Answer", responder |-> responder]

\* Coordinator message: a node declares itself leader
CoordinatorMsg(leader) == [type |-> "Coordinator", leader |-> leader]

\* --- Protocol actions (adapted from generated Election.tla with message tracking) ---

\* A node detects that the current leader has failed and starts an election
DetectFailure(node) ==
    /\ node \in state.alive
    /\ state.has_leader = TRUE
    /\ ~(state.leader \in state.alive)
    /\ state' = [state EXCEPT
        !.electing = state.electing \cup {node},
        !.waiting_answer = TRUE,
        !.waiting_node = node]
    /\ msgs' = msgs \cup {ElectionMsg(node)}
    /\ UNCHANGED constants

\* A node initiates a new election (when there is no leader)
StartElection(node) ==
    /\ node \in state.alive
    /\ state' = [state EXCEPT
        !.electing = state.electing \cup {node},
        !.has_leader = FALSE,
        !.leader = 0,
        !.waiting_answer = TRUE,
        !.waiting_node = node]
    /\ msgs' = msgs \cup {ElectionMsg(node)}
    /\ UNCHANGED constants

\* A higher-ID node responds to an election message from a lower-ID sender
SendAnswer(node, sender) ==
    /\ node \in state.alive
    /\ node > sender
    /\ ElectionMsg(sender) \in msgs
    /\ state' = [state EXCEPT
        !.electing = state.electing \cup {node},
        !.has_highest = TRUE,
        !.highest_heard = IF ~state.has_highest \/ node > state.highest_heard
                          THEN node ELSE state.highest_heard]
    /\ msgs' = msgs \cup {AnswerMsg(node)}
    /\ UNCHANGED constants

\* A node receives an answer from a higher-ID node (backs down)
ReceiveAnswer(node, responder) ==
    /\ node \in state.alive
    /\ state.waiting_answer = TRUE
    /\ state.waiting_node = node
    /\ AnswerMsg(responder) \in msgs
    /\ state' = [state EXCEPT
        !.waiting_answer = FALSE,
        !.waiting_node = 0,
        !.electing = state.electing \ {node}]
    /\ UNCHANGED <<msgs, constants>>

\* A node that started an election and received no answer declares itself leader
SendCoordinator(node) ==
    /\ node \in state.alive
    /\ node \in state.electing
    /\ state.waiting_answer = TRUE
    /\ state.waiting_node = node
    /\ state' = [state EXCEPT
        !.has_leader = TRUE,
        !.leader = node,
        !.electing = state.electing \ {node},
        !.waiting_answer = FALSE,
        !.waiting_node = 0]
    /\ msgs' = msgs \cup {CoordinatorMsg(node)}
    /\ UNCHANGED constants

\* A node receives a coordinator message and accepts the new leader
ReceiveCoordinator(node, leader) ==
    /\ node \in state.alive
    /\ CoordinatorMsg(leader) \in msgs
    /\ state' = [state EXCEPT
        !.has_leader = TRUE,
        !.leader = leader,
        !.electing = state.electing \ {node}]
    /\ UNCHANGED <<msgs, constants>>

\* A node fails (crashes)
NodeFail(node) ==
    /\ node \in state.alive
    /\ state' = [state EXCEPT
        !.alive = state.alive \ {node},
        !.electing = state.electing \ {node},
        !.has_leader = IF state.has_leader /\ state.leader = node
                       THEN FALSE ELSE state.has_leader,
        !.leader = IF state.has_leader /\ state.leader = node
                   THEN 0 ELSE state.leader,
        !.waiting_answer = IF state.waiting_answer /\ state.waiting_node = node
                           THEN FALSE ELSE state.waiting_answer,
        !.waiting_node = IF state.waiting_answer /\ state.waiting_node = node
                         THEN 0 ELSE state.waiting_node]
    /\ UNCHANGED <<msgs, constants>>

\* --- Standard TLA+ state machine ---

StateInit ==
    /\ constants = ConstantsRecord
    /\ state = [electing |-> {},
                has_leader |-> FALSE,
                leader |-> 0,
                alive |-> Nodes,
                has_highest |-> FALSE,
                highest_heard |-> 0,
                waiting_answer |-> FALSE,
                waiting_node |-> 0]
    /\ msgs = {}

StateNext ==
    \/ \E node \in Nodes : DetectFailure(node)
    \/ \E node \in Nodes : StartElection(node)
    \/ \E node \in Nodes, sender \in Nodes : SendAnswer(node, sender)
    \/ \E node \in Nodes, responder \in Nodes : ReceiveAnswer(node, responder)
    \/ \E node \in Nodes : SendCoordinator(node)
    \/ \E node \in Nodes, leader \in Nodes : ReceiveCoordinator(node, leader)
    \/ \E node \in Nodes : NodeFail(node)

vars == <<state, constants, msgs>>

Spec == StateInit /\ [][StateNext]_vars

\* --- Safety Invariants ---

\* Type invariant: state fields have expected types
TypeOK ==
    /\ state.electing \subseteq Nodes
    /\ state.alive \subseteq Nodes
    /\ state.has_leader \in BOOLEAN
    /\ state.has_highest \in BOOLEAN
    /\ state.waiting_answer \in BOOLEAN
    /\ state.leader \in (Nodes \cup {0})
    /\ state.highest_heard \in (Nodes \cup {0})
    /\ state.waiting_node \in (Nodes \cup {0})

\* Safety: If a leader is declared and the leader is alive, it should be
\* a member of the alive set
LeaderIsAliveOrNone ==
    (state.has_leader /\ state.leader \in state.alive) =>
        state.leader \in Nodes

\* Safety: The leader field is either 0 (no leader) or a valid node
LeaderValid ==
    state.has_leader => state.leader \in Nodes

\* Safety: Only alive nodes can be in the electing set
ElectingSubsetAlive ==
    state.electing \subseteq state.alive

\* Safety: The waiting node must be alive if waiting
WaitingNodeAlive ==
    state.waiting_answer => state.waiting_node \in state.alive

====
