---- MODULE Raft_MC ----
\* Model-checking wrapper for the relational Raft spec generated by verus2tla.
\* Adapts the (s, s_, c) relational style to standard TLA+ VARIABLE form.
\*
\* NOTE: Full multi-node Raft model checking is infeasible with TLC due to
\* state space explosion from Seq-based logs and [u64 -> u64] function maps.
\* This wrapper checks single-node local invariants only.

EXTENDS Integers, Sequences, FiniteSets

\* Finite model constants for TLC
CONSTANTS Follower_tag, Candidate_tag, Leader_tag

\* Server IDs for finite model
Servers == {1, 2, 3}
QuorumSize == 2
MyId == 1
MaxTerm == 3
MaxLogLen == 2
Values == {10, 20}

\* State variables
VARIABLE state, constants

\* Role tags
Follower == [tag |-> Follower_tag]
Candidate == [tag |-> Candidate_tag]
Leader == [tag |-> Leader_tag]

\* --- State machine ---

StateInit ==
    /\ constants = [servers |-> Servers, quorum_size |-> QuorumSize, my_id |-> MyId]
    /\ state = [current_term |-> 0, role |-> Follower, has_voted |-> FALSE,
                voted_for |-> 0, log |-> <<>>, commit_index |-> 0,
                votes_granted |-> {}, match_index |-> <<>>, next_index |-> <<>>]

\* Timeout: follower/candidate starts new election
Timeout ==
    /\ state.role = Follower \/ state.role = Candidate
    /\ state.current_term < MaxTerm
    /\ state' = [state EXCEPT
        !.current_term = state.current_term + 1,
        !.role = Candidate,
        !.has_voted = TRUE,
        !.voted_for = constants.my_id,
        !.votes_granted = {constants.my_id}]
    /\ UNCHANGED constants

\* GrantVote: vote for a candidate
GrantVote(candidate_term, candidate_id) ==
    /\ candidate_term >= state.current_term
    /\ candidate_term <= MaxTerm
    /\ candidate_id \in Servers
    /\ ~state.has_voted \/ state.voted_for = candidate_id
    /\ state' = [state EXCEPT
        !.current_term = candidate_term,
        !.role = Follower,
        !.has_voted = TRUE,
        !.voted_for = candidate_id]
    /\ UNCHANGED constants

\* ReceiveVoteGranted: collect a vote
ReceiveVoteGranted(voter) ==
    /\ state.role = Candidate
    /\ voter \in Servers
    /\ state' = [state EXCEPT
        !.votes_granted = state.votes_granted \cup {voter}]
    /\ UNCHANGED constants

\* BecomeLeader: transition to leader after quorum
BecomeLeader ==
    /\ state.role = Candidate
    /\ Cardinality(state.votes_granted) >= QuorumSize
    /\ state' = [state EXCEPT
        !.role = Leader,
        !.match_index = <<>>,
        !.next_index = <<>>]
    /\ UNCHANGED constants

\* ClientRequest: leader appends to log
ClientRequest(value) ==
    /\ state.role = Leader
    /\ Len(state.log) < MaxLogLen
    /\ state' = [state EXCEPT
        !.log = Append(state.log, [term |-> state.current_term, value |-> value])]
    /\ UNCHANGED constants

\* StepDown: step down on higher term
StepDown(new_term) ==
    /\ new_term > state.current_term
    /\ new_term <= MaxTerm
    /\ state' = [state EXCEPT
        !.current_term = new_term,
        !.role = Follower,
        !.has_voted = FALSE,
        !.voted_for = 0,
        !.votes_granted = {}]
    /\ UNCHANGED constants

\* AdvanceCommitIndex: leader advances commit
AdvanceCommitIndex(new_ci) ==
    /\ state.role = Leader
    /\ new_ci > state.commit_index
    /\ new_ci <= Len(state.log)
    /\ state' = [state EXCEPT !.commit_index = new_ci]
    /\ UNCHANGED constants

StateNext ==
    \/ Timeout
    \/ \E ct \in 0..MaxTerm, cid \in Servers : GrantVote(ct, cid)
    \/ \E v \in Servers : ReceiveVoteGranted(v)
    \/ BecomeLeader
    \/ \E val \in Values : ClientRequest(val)
    \/ \E nt \in 1..MaxTerm : StepDown(nt)
    \/ \E ci \in 1..MaxLogLen : AdvanceCommitIndex(ci)

vars == <<state, constants>>
Spec == StateInit /\ [][StateNext]_vars

\* --- Safety Invariants ---

\* Term is non-negative and bounded
TermBounded ==
    state.current_term >= 0 /\ state.current_term <= MaxTerm

\* Role is a valid tag
RoleValid ==
    state.role \in {Follower, Candidate, Leader}

\* Voting consistency: if voted, voted_for is a valid server
VotingConsistency ==
    state.has_voted => state.voted_for \in Servers

\* Commit index never exceeds log length
CommitBounded ==
    state.commit_index <= Len(state.log)

\* Leader has voted (for itself during election)
LeaderVoted ==
    state.role = Leader => state.has_voted

\* Candidate has voted for itself
CandidateVotedForSelf ==
    state.role = Candidate =>
        (state.has_voted /\ state.voted_for = constants.my_id)

====
