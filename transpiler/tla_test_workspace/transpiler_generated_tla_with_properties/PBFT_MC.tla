---- MODULE PBFT_MC ----
\* Model-checking wrapper for the relational PBFT spec generated by verus2tla.
\* Adapts the (s, s_, c) relational style to standard TLA+ VARIABLE form.
\*
\* NOTE: Full multi-node PBFT model checking is infeasible with TLC due to
\* state space explosion from set-based sender tracking across n >= 3f+1 nodes.
\* This wrapper checks single-node local invariants only.

EXTENDS Integers, Sequences, FiniteSets

\* Finite model constants for TLC
CONSTANTS PrePrepare_tag, Prepare_tag, Commit_tag, Replied_tag

\* PBFT parameters (n = 4, f = 1)
N == 4
F == 1
NodeId == 0
CheckpointInterval == 5
Nodes == 0..(N-1)
MaxSeq == 3
Digests == {100, 200}

\* State variables
VARIABLE state, constants

\* Phase tags
PrePrepare == [tag |-> PrePrepare_tag]
Prepare == [tag |-> Prepare_tag]
CommitPhase == [tag |-> Commit_tag]
Replied == [tag |-> Replied_tag]

\* --- State machine ---

StateInit ==
    /\ constants = [n |-> N, f |-> F, node_id |-> NodeId,
                    checkpoint_interval |-> CheckpointInterval]
    /\ state = [view |-> 0, phase |-> PrePrepare, prepare_senders |-> {},
                commit_senders |-> {}, seq_num |-> 0, is_primary |-> TRUE,
                request_digest |-> 0, checkpoint_seq |-> 0,
                checkpoint_digest |-> 0, low_watermark |-> 0,
                high_watermark |-> CheckpointInterval]

\* PrePrepare: primary broadcasts request
DoPrePrepare(digest) ==
    /\ state.phase = PrePrepare
    /\ state.is_primary = TRUE
    /\ state.seq_num >= state.low_watermark
    /\ state.seq_num < state.high_watermark
    /\ state' = [state EXCEPT
        !.phase = Prepare,
        !.request_digest = digest,
        !.prepare_senders = {constants.node_id},
        !.commit_senders = {}]
    /\ UNCHANGED constants

\* ReceivePrePrepare: non-primary receives request
ReceivePrePrepare(digest) ==
    /\ state.phase = PrePrepare
    /\ state.is_primary = FALSE
    /\ state' = [state EXCEPT
        !.phase = Prepare,
        !.request_digest = digest,
        !.prepare_senders = {constants.node_id},
        !.commit_senders = {}]
    /\ UNCHANGED constants

\* ReceivePrepare: collect prepare message
ReceivePrepare(sender) ==
    /\ state.phase = Prepare
    /\ ~(sender \in state.prepare_senders)
    /\ sender \in Nodes
    /\ state' = [state EXCEPT
        !.prepare_senders = state.prepare_senders \cup {sender}]
    /\ UNCHANGED constants

\* EnterCommit: enter commit after 2f+1 prepares
EnterCommit ==
    /\ state.phase = Prepare
    /\ Cardinality(state.prepare_senders) >= (2 * F) + 1
    /\ state' = [state EXCEPT
        !.phase = CommitPhase,
        !.commit_senders = {constants.node_id}]
    /\ UNCHANGED constants

\* ReceiveCommit: collect commit message
ReceiveCommit(sender) ==
    /\ state.phase = CommitPhase
    /\ ~(sender \in state.commit_senders)
    /\ sender \in Nodes
    /\ state' = [state EXCEPT
        !.commit_senders = state.commit_senders \cup {sender}]
    /\ UNCHANGED constants

\* ExecuteReply: execute after 2f+1 commits
ExecuteReply ==
    /\ state.phase = CommitPhase
    /\ Cardinality(state.commit_senders) >= (2 * F) + 1
    /\ state' = [state EXCEPT
        !.phase = Replied,
        !.seq_num = state.seq_num + 1,
        !.prepare_senders = {},
        !.commit_senders = {}]
    /\ UNCHANGED constants

\* ViewChange: initiate view change
ViewChange ==
    /\ state' = [state EXCEPT
        !.view = state.view + 1,
        !.phase = PrePrepare,
        !.prepare_senders = {},
        !.commit_senders = {},
        !.request_digest = 0]
    /\ UNCHANGED constants

\* NewRound: start new consensus round after reply
NewRound ==
    /\ state.phase = Replied
    /\ state' = [state EXCEPT
        !.phase = PrePrepare,
        !.prepare_senders = {},
        !.commit_senders = {},
        !.request_digest = 0]
    /\ UNCHANGED constants

StateNext ==
    \/ \E d \in Digests : DoPrePrepare(d)
    \/ \E d \in Digests : ReceivePrePrepare(d)
    \/ \E s \in Nodes : ReceivePrepare(s)
    \/ EnterCommit
    \/ \E s \in Nodes : ReceiveCommit(s)
    \/ ExecuteReply
    \/ ViewChange
    \/ NewRound

vars == <<state, constants>>
Spec == StateInit /\ [][StateNext]_vars

\* --- Safety Invariants ---

\* Phase is a valid tag
PhaseValid ==
    state.phase \in {PrePrepare, Prepare, CommitPhase, Replied}

\* View is non-negative
ViewNonNeg ==
    state.view >= 0

\* Sequence number is non-negative
SeqNonNeg ==
    state.seq_num >= 0

\* Watermarks are ordered
WatermarkOrdered ==
    state.low_watermark <= state.high_watermark

\* Prepare quorum: commit phase requires sufficient prepares
CommitRequiresPrepares ==
    state.phase = CommitPhase =>
        Cardinality(state.prepare_senders) >= (2 * F) + 1

\* Checkpoint precedes or equals current sequence
CheckpointPrecedesSeq ==
    state.checkpoint_seq <= state.seq_num

====
