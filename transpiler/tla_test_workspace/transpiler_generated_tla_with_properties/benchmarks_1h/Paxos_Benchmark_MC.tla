---- MODULE Paxos_Benchmark_MC ----
\* Benchmark wrapper for Paxos matching source-first benchmark config.
\* Model: 3 nodes, quorum=2, values={0,1,2}, ballots={0,1,2,3}.
\* Source-first: BLOCKED (candidate enumeration can't find transitions).
\* Historical TLC reference: TIMEOUT (~109M states, ~18M distinct in 5min).
\*
\* Base spec generated by: verus-transpile verus2-tla --batch
\*   --input src/protocol/Paxos --output .../Paxos --spec-prefix L

EXTENDS Integers, Sequences, FiniteSets

\* 3 nodes matching source-first config (both proposers and acceptors)
Nodes == {0, 1, 2}

\* Ballot numbers: 0 means none
Ballots == {0, 1, 2, 3}
NonZeroBallots == {1, 2, 3}

\* Values (0 means none/unset)
Values == {0, 1, 2}
NonZeroValues == {1, 2}

\* Quorum size matching source-first
QuorumSize == 2

CONSTANTS Idle_tag, Phase1_tag, Phase2_tag, Decided_tag

VARIABLE state, msgs

vars == <<state, msgs>>

\* --- Message constructors ---
Msg1a(bal) == [type |-> "1a", bal |-> bal]
Msg1b(acc, bal, accepted_bal, accepted_val) ==
    [type |-> "1b", acc |-> acc, bal |-> bal,
     accepted_bal |-> accepted_bal, accepted_val |-> accepted_val]
Msg2a(bal, val) == [type |-> "2a", bal |-> bal, val |-> val]
Msg2b(acc, bal, val) == [type |-> "2b", acc |-> acc, bal |-> bal, val |-> val]

\* --- Initial state ---
StateInit ==
    /\ state = [n \in Nodes |->
        [promised_bal          |-> 0,
         accepted_bal          |-> 0,
         accepted_val          |-> 0,
         proposer_bal          |-> 0,
         phase                 |-> Idle_tag,
         promises_rcvd         |-> {},
         highest_accepted_bal  |-> 0,
         highest_accepted_val  |-> 0,
         proposed_val          |-> 0,
         accepts_rcvd          |-> {},
         decided_val           |-> 0]]
    /\ msgs = {}

\* --- Protocol actions ---

Send1a(n) ==
    /\ state[n].phase = Idle_tag
    /\ n > state[n].proposer_bal
    /\ state' = [state EXCEPT ![n] =
        [@ EXCEPT !.proposer_bal = n,
                   !.phase = Phase1_tag,
                   !.promises_rcvd = {},
                   !.highest_accepted_bal = 0,
                   !.highest_accepted_val = 0]]
    /\ msgs' = msgs \cup {Msg1a(n)}

Send1b(n, b) ==
    /\ Msg1a(b) \in msgs
    /\ b >= state[n].promised_bal
    /\ state' = [state EXCEPT ![n] =
        [@ EXCEPT !.promised_bal = b]]
    /\ msgs' = msgs \cup {Msg1b(n, b, state[n].accepted_bal, state[n].accepted_val)}

RecvPromise(n, m) ==
    /\ state[n].phase = Phase1_tag
    /\ m \in msgs
    /\ m.type = "1b"
    /\ m.bal = state[n].proposer_bal
    /\ m.acc \in Nodes
    /\ ~(m.acc \in state[n].promises_rcvd)
    /\ state' = [state EXCEPT ![n] =
        [@ EXCEPT !.promises_rcvd = state[n].promises_rcvd \cup {m.acc},
                   !.highest_accepted_bal = IF m.accepted_bal > state[n].highest_accepted_bal
                                            THEN m.accepted_bal
                                            ELSE state[n].highest_accepted_bal,
                   !.highest_accepted_val = IF m.accepted_bal > state[n].highest_accepted_bal
                                            THEN m.accepted_val
                                            ELSE state[n].highest_accepted_val]]
    /\ UNCHANGED msgs

Send2a(n, v) ==
    /\ state[n].phase = Phase1_tag
    /\ Cardinality(state[n].promises_rcvd) >= QuorumSize
    /\ v \in NonZeroValues
    /\ LET chosen_val == IF state[n].highest_accepted_bal > 0
                          THEN state[n].highest_accepted_val
                          ELSE v
       IN  /\ state' = [state EXCEPT ![n] =
               [@ EXCEPT !.proposed_val = chosen_val,
                          !.phase = Phase2_tag,
                          !.accepts_rcvd = {}]]
           /\ msgs' = msgs \cup {Msg2a(state[n].proposer_bal, chosen_val)}

Send2b(n, b, v) ==
    /\ Msg2a(b, v) \in msgs
    /\ b >= state[n].promised_bal
    /\ state' = [state EXCEPT ![n] =
        [@ EXCEPT !.promised_bal = b,
                   !.accepted_bal = b,
                   !.accepted_val = v]]
    /\ msgs' = msgs \cup {Msg2b(n, b, v)}

RecvAccepted(n, a) ==
    /\ state[n].phase = Phase2_tag
    /\ a \in Nodes
    /\ ~(a \in state[n].accepts_rcvd)
    /\ Msg2b(a, state[n].proposer_bal, state[n].proposed_val) \in msgs
    /\ state' = [state EXCEPT ![n] =
        [@ EXCEPT !.accepts_rcvd = state[n].accepts_rcvd \cup {a}]]
    /\ UNCHANGED msgs

Learn(n) ==
    /\ state[n].phase = Phase2_tag
    /\ Cardinality(state[n].accepts_rcvd) >= QuorumSize
    /\ state' = [state EXCEPT ![n] =
        [@ EXCEPT !.phase = Decided_tag,
                   !.decided_val = state[n].proposed_val]]
    /\ UNCHANGED msgs

\* --- Next state relation ---

StateNext ==
    \/ \E n \in Nodes : Send1a(n)
    \/ \E n \in Nodes, b \in NonZeroBallots : Send1b(n, b)
    \/ \E n \in Nodes, m \in msgs : RecvPromise(n, m)
    \/ \E n \in Nodes, v \in NonZeroValues : Send2a(n, v)
    \/ \E n \in Nodes, b \in NonZeroBallots, v \in NonZeroValues : Send2b(n, b, v)
    \/ \E n \in Nodes, a \in Nodes : RecvAccepted(n, a)
    \/ \E n \in Nodes : Learn(n)

Spec == StateInit /\ [][StateNext]_vars

\* --- Safety Invariants (matching source-first benchmark invariants) ---

\* Source-first: LSafetyAcceptedBallotBoundedByPromise
AcceptedBallotBoundedByPromise ==
    \A n \in Nodes :
        state[n].accepted_bal <= state[n].promised_bal

\* Source-first: LSafetyDecidedRequiresQuorum
DecidedRequiresQuorum ==
    \A n \in Nodes :
        state[n].phase = Decided_tag =>
            Cardinality(state[n].accepts_rcvd) >= QuorumSize

\* Source-first: LSafetyDecidedMatchesProposedValue
DecidedMatchesProposedValue ==
    \A n \in Nodes :
        state[n].phase = Decided_tag =>
            state[n].decided_val = state[n].proposed_val

====
