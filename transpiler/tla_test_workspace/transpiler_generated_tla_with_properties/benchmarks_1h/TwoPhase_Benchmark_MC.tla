---- MODULE TwoPhase_Benchmark_MC ----
\* Benchmark wrapper for TwoPhase matching source-first benchmark config.
\* Model: 2 resource managers (matches twophase_benchmark.model.toml).
\* Historical TLC reference: 3 RMs → 926 states, 304 distinct, 10 depth, 1s.
\*
\* Base spec generated by: verus-transpile verus2-tla --batch
\*   --input src/protocol/TwoPhase --output .../TwoPhase --spec-prefix L
\* This wrapper adds message channel + finite-domain state machine.

EXTENDS Integers, Sequences, FiniteSets

\* Finite model constants for TLC
CONSTANTS Init_tag, Committed_tag, Aborted_tag

\* Resource managers — 2 RMs to match source-first benchmark
RMs == {0, 1}

\* State variables
VARIABLE state, constants, msgs

\* Construct the constants record
ConstantsRecord == [rm |-> RMs]

\* TMState tags
TMInit == [tag |-> Init_tag]
TMCommitted == [tag |-> Committed_tag]
TMAborted == [tag |-> Aborted_tag]

\* Message types
PrepareMsg == [type |-> "Prepare"]
CommitMsg == [type |-> "Commit"]
AbortMsg == [type |-> "Abort"]
PreparedMsg(rm) == [type |-> "Prepared", rm |-> rm]

\* --- Protocol actions ---

TMSendPrepare ==
    /\ state.tm_state = TMInit
    /\ state' = state
    /\ msgs' = msgs \cup {PrepareMsg}
    /\ UNCHANGED constants

RMReceivePrepare(rm) ==
    /\ rm \in ConstantsRecord.rm
    /\ PrepareMsg \in msgs
    /\ ~(rm \in state.rm_prepared)
    /\ ~(rm \in state.rm_aborted)
    /\ state' = [state EXCEPT !.rm_prepared = state.rm_prepared \cup {rm}]
    /\ msgs' = msgs \cup {PreparedMsg(rm)}
    /\ UNCHANGED constants

RMAbort(rm) ==
    /\ rm \in ConstantsRecord.rm
    /\ ~(rm \in state.rm_prepared)
    /\ ~(rm \in state.rm_aborted)
    /\ ~(rm \in state.rm_committed)
    /\ state' = [state EXCEPT !.rm_aborted = state.rm_aborted \cup {rm}]
    /\ UNCHANGED <<msgs, constants>>

TMRcvPrepared(r) ==
    /\ state.tm_state = TMInit
    /\ PreparedMsg(r) \in msgs
    /\ state' = [state EXCEPT !.tm_prepared = state.tm_prepared \cup {r}]
    /\ UNCHANGED <<msgs, constants>>

TMSendCommit ==
    /\ state.tm_state = TMInit
    /\ state.tm_prepared = ConstantsRecord.rm
    /\ state' = [state EXCEPT !.tm_state = TMCommitted]
    /\ msgs' = msgs \cup {CommitMsg}
    /\ UNCHANGED constants

TMSendAbort ==
    /\ state.tm_state = TMInit
    /\ state' = [state EXCEPT !.tm_state = TMAborted]
    /\ msgs' = msgs \cup {AbortMsg}
    /\ UNCHANGED constants

RMReceiveCommit(rm) ==
    /\ rm \in ConstantsRecord.rm
    /\ CommitMsg \in msgs
    /\ rm \in state.rm_prepared
    /\ ~(rm \in state.rm_committed)
    /\ state' = [state EXCEPT !.rm_committed = state.rm_committed \cup {rm}]
    /\ UNCHANGED <<msgs, constants>>

RMReceiveAbort(rm) ==
    /\ rm \in ConstantsRecord.rm
    /\ AbortMsg \in msgs
    /\ ~(rm \in state.rm_committed)
    /\ ~(rm \in state.rm_aborted)
    /\ state' = [state EXCEPT !.rm_aborted = state.rm_aborted \cup {rm}]
    /\ UNCHANGED <<msgs, constants>>

\* --- State machine ---

StateInit ==
    /\ constants = ConstantsRecord
    /\ state = [tm_state |-> TMInit,
                tm_prepared |-> {},
                rm_prepared |-> {},
                rm_committed |-> {},
                rm_aborted |-> {}]
    /\ msgs = {}

StateNext ==
    \/ TMSendPrepare
    \/ \E rm \in RMs : RMReceivePrepare(rm)
    \/ \E rm \in RMs : RMAbort(rm)
    \/ \E r \in RMs : TMRcvPrepared(r)
    \/ TMSendCommit
    \/ TMSendAbort
    \/ \E rm \in RMs : RMReceiveCommit(rm)
    \/ \E rm \in RMs : RMReceiveAbort(rm)

vars == <<state, constants, msgs>>

Spec == StateInit /\ [][StateNext]_vars

\* --- Safety Invariants (matching source-first benchmark invariants) ---
\* Source-first: LSafetyNoCommitAbortOverlap
NoCommitAbortOverlap ==
    \A rm \in RMs :
        ~(rm \in state.rm_committed /\ rm \in state.rm_aborted)

\* Source-first: LSafetyCommittedSubsetPrepared
CommittedSubsetPrepared ==
    \A rm \in RMs :
        rm \in state.rm_committed => rm \in state.rm_prepared

\* Source-first: LSafetyTmCommittedRequiresAllPrepared
TmCommittedRequiresAllPrepared ==
    state.tm_state = TMCommitted =>
        state.tm_prepared = RMs

====
