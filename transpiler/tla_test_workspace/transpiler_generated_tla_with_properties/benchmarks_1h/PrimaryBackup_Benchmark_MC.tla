---- MODULE PrimaryBackup_Benchmark_MC ----
\* Benchmark wrapper for PrimaryBackup matching source-first benchmark config.
\* Model: max_log_len=1, values={0,1}, max_view=2.
\* Source-first config: primarybackup_benchmark.model.toml
\* Historical TLC reference: 786 states, 438 distinct, 7 depth, 1s.
\*
\* Base spec generated by: verus-transpile verus2-tla --batch
\*   --input src/protocol/PrimaryBackup --output .../PrimaryBackup --spec-prefix L

EXTENDS Integers, Sequences, FiniteSets

\* Finite model constants
CONSTANTS Primary_tag, Inactive_tag

\* Matching source-first benchmark: max_log_len=1, int domain 0..1
Values == {0, 1}
MaxLogLen == 1
MaxView == 2

VARIABLE state, constants, msgs

ConstantsRecord == [max_log_len |-> MaxLogLen]

PrimaryRole == [tag |-> Primary_tag]
InactiveRole == [tag |-> Inactive_tag]

ReplicateMsg(v) == [type |-> "Replicate", val |-> v]
AckMsg == [type |-> "Ack"]

\* --- Protocol actions ---

PrimaryWrite(val) ==
    /\ state.role = PrimaryRole
    /\ state.phase = "Idle"
    /\ state.has_pending = FALSE
    /\ state.log_length < ConstantsRecord.max_log_len
    /\ val \in Values
    /\ state' = [state EXCEPT !.has_pending = TRUE,
                               !.pending_value = val,
                               !.acked = FALSE]
    /\ UNCHANGED <<msgs, constants>>

PrimarySendReplicate ==
    /\ state.role = PrimaryRole
    /\ state.has_pending = TRUE
    /\ state.acked = FALSE
    /\ state.phase = "Idle"
    /\ state' = [state EXCEPT !.phase = "WaitBackup"]
    /\ msgs' = msgs \cup {ReplicateMsg(state.pending_value)}
    /\ UNCHANGED constants

BackupReceiveReplicate(val) ==
    /\ state.role = PrimaryRole
    /\ state.phase = "WaitBackup"
    /\ ReplicateMsg(val) \in msgs
    /\ state' = [state EXCEPT !.backup_log_length = state.backup_log_length + 1,
                               !.backup_last_value = val,
                               !.backup_synced = TRUE,
                               !.phase = "WaitAck"]
    /\ msgs' = msgs \ {ReplicateMsg(val)}
    /\ UNCHANGED constants

BackupSendAck ==
    /\ state.role = PrimaryRole
    /\ state.phase = "WaitAck"
    /\ state.backup_synced = TRUE
    /\ state' = [state EXCEPT !.phase = "ReadyToCommit"]
    /\ msgs' = msgs \cup {AckMsg}
    /\ UNCHANGED constants

PrimaryReceiveAck ==
    /\ state.role = PrimaryRole
    /\ state.phase = "ReadyToCommit"
    /\ state.has_pending = TRUE
    /\ AckMsg \in msgs
    /\ state' = [state EXCEPT !.acked = TRUE,
                               !.phase = "ReadyToCommit"]
    /\ msgs' = msgs \ {AckMsg}
    /\ UNCHANGED constants

PrimaryCommit ==
    /\ state.role = PrimaryRole
    /\ state.acked = TRUE
    /\ state.has_pending = TRUE
    /\ state' = [state EXCEPT !.log_length = state.log_length + 1,
                               !.last_value = state.pending_value,
                               !.has_pending = FALSE,
                               !.pending_value = 0,
                               !.acked = TRUE,
                               !.phase = "Idle"]
    /\ UNCHANGED <<msgs, constants>>

PrimaryFail ==
    /\ state.role = PrimaryRole
    /\ state' = [state EXCEPT !.role = InactiveRole,
                               !.has_pending = FALSE,
                               !.pending_value = 0,
                               !.acked = TRUE,
                               !.backup_synced = FALSE,
                               !.phase = "Idle"]
    /\ msgs' = {}
    /\ UNCHANGED constants

BackupPromote ==
    /\ state.role = InactiveRole
    /\ state.view < MaxView
    /\ state' = [state EXCEPT !.role = PrimaryRole,
                               !.log_length = state.backup_log_length,
                               !.last_value = state.backup_last_value,
                               !.has_pending = FALSE,
                               !.pending_value = 0,
                               !.acked = TRUE,
                               !.backup_synced = TRUE,
                               !.view = state.view + 1,
                               !.phase = "Idle"]
    /\ msgs' = {}
    /\ UNCHANGED constants

\* --- State machine ---

StateInit ==
    /\ constants = ConstantsRecord
    /\ state = [role |-> PrimaryRole,
                log_length |-> 0,
                last_value |-> 0,
                has_pending |-> FALSE,
                pending_value |-> 0,
                acked |-> TRUE,
                backup_log_length |-> 0,
                backup_last_value |-> 0,
                backup_synced |-> TRUE,
                view |-> 0,
                phase |-> "Idle"]
    /\ msgs = {}

StateNext ==
    \/ \E val \in Values : PrimaryWrite(val)
    \/ PrimarySendReplicate
    \/ \E val \in Values : BackupReceiveReplicate(val)
    \/ BackupSendAck
    \/ PrimaryReceiveAck
    \/ PrimaryCommit
    \/ PrimaryFail
    \/ BackupPromote

vars == <<state, constants, msgs>>

Spec == StateInit /\ [][StateNext]_vars

\* --- Safety Invariants (matching source-first benchmark invariants) ---

\* Source-first: LSafetyNoPendingImpliesClearedValue
NoPendingImpliesClearedValue ==
    state.has_pending = FALSE => state.pending_value = 0

\* Source-first: LSafetyUnackedImpliesPending
UnackedImpliesPending ==
    state.acked = FALSE => state.has_pending = TRUE

\* Source-first: LSafetyInactiveStateIsQuiescent
InactiveStateIsQuiescent ==
    state.role = InactiveRole =>
        (state.has_pending = FALSE /\ state.acked = TRUE /\ state.backup_synced = FALSE)

====
