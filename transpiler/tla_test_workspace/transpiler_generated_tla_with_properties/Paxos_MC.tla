---- MODULE Paxos_MC ----
\* Model-checking wrapper for the relational Paxos spec generated by verus2tla.
\* Adds per-node state, message channel, finite domains, and safety invariants.
\*
\* The generated spec uses relational-style (s, s_, c) parameters.
\* This wrapper lifts to multi-node Paxos with explicit message tracking.
\*
\* Ballot ownership: node n can only propose with ballot n.
\* With 3 nodes {1,2,3}, ballots are {1,2,3}, quorum size is 2.
\* This is the standard majority quorum Paxos configuration.

EXTENDS Integers, Sequences, FiniteSets

\* --- Finite domains for model checking ---

\* 3 nodes: act as both proposers and acceptors
Nodes == {1, 2, 3}

\* Ballot numbers: 0 means none. Each node owns exactly ballot = its id.
Ballots == {0, 1, 2, 3}
NonZeroBallots == {1, 2, 3}

\* Proposable values (0 means none/unset)
Values == {0, 1, 2}
NonZeroValues == {1, 2}

\* Quorum size for 3 nodes (majority)
QuorumSize == 2

\* --- Phase tags ---
CONSTANTS Idle_tag, Phase1_tag, Phase2_tag, Decided_tag

\* --- State variables ---
\* state[n] is the per-node state record
\* msgs is the global message pool (set of tagged records)
VARIABLE state, msgs

vars == <<state, msgs>>

\* --- Message constructors ---
Msg1a(bal) ==
    [type |-> "1a", bal |-> bal]

Msg1b(acc, bal, accepted_bal, accepted_val) ==
    [type |-> "1b", acc |-> acc, bal |-> bal,
     accepted_bal |-> accepted_bal, accepted_val |-> accepted_val]

Msg2a(bal, val) ==
    [type |-> "2a", bal |-> bal, val |-> val]

Msg2b(acc, bal, val) ==
    [type |-> "2b", acc |-> acc, bal |-> bal, val |-> val]

\* --- Initial state ---
StateInit ==
    /\ state = [n \in Nodes |->
        [promised_bal          |-> 0,
         accepted_bal          |-> 0,
         accepted_val          |-> 0,
         proposer_bal          |-> 0,
         phase                 |-> Idle_tag,
         promises_rcvd         |-> {},
         highest_accepted_bal  |-> 0,
         highest_accepted_val  |-> 0,
         proposed_val          |-> 0,
         accepts_rcvd          |-> {},
         decided_val           |-> 0]]
    /\ msgs = {}

\* --- Protocol actions ---

\* Send1a: proposer n starts phase 1 with ballot n (its own ballot).
\* Corresponds to Send1a(s, s_, c, b) in generated spec.
Send1a(n) ==
    /\ state[n].phase = Idle_tag
    /\ n > state[n].proposer_bal  \* ballot n > current proposer_bal (always true from init)
    /\ state' = [state EXCEPT ![n] =
        [@ EXCEPT !.proposer_bal = n,
                   !.phase = Phase1_tag,
                   !.promises_rcvd = {},
                   !.highest_accepted_bal = 0,
                   !.highest_accepted_val = 0]]
    /\ msgs' = msgs \cup {Msg1a(n)}

\* Send1b: acceptor n responds to a 1a message for ballot b.
\* Corresponds to Send1b(s, s_, c, b) in generated spec.
Send1b(n, b) ==
    /\ Msg1a(b) \in msgs
    /\ b >= state[n].promised_bal
    /\ state' = [state EXCEPT ![n] =
        [@ EXCEPT !.promised_bal = b]]
    /\ msgs' = msgs \cup {Msg1b(n, b, state[n].accepted_bal, state[n].accepted_val)}

\* RecvPromise: proposer n receives a 1b message m from the pool.
\* Corresponds to RecvPromise(s, s_, c, a, a_accepted_bal, a_accepted_val).
RecvPromise(n, m) ==
    /\ state[n].phase = Phase1_tag
    /\ m \in msgs
    /\ m.type = "1b"
    /\ m.bal = state[n].proposer_bal
    /\ m.acc \in Nodes
    /\ ~(m.acc \in state[n].promises_rcvd)
    /\ state' = [state EXCEPT ![n] =
        [@ EXCEPT !.promises_rcvd = state[n].promises_rcvd \cup {m.acc},
                   !.highest_accepted_bal = IF m.accepted_bal > state[n].highest_accepted_bal
                                            THEN m.accepted_bal
                                            ELSE state[n].highest_accepted_bal,
                   !.highest_accepted_val = IF m.accepted_bal > state[n].highest_accepted_bal
                                            THEN m.accepted_val
                                            ELSE state[n].highest_accepted_val]]
    /\ UNCHANGED msgs

\* Send2a: proposer n has enough promises, sends phase 2 with value.
\* Corresponds to Send2a(s, s_, c, v) in generated spec.
Send2a(n, v) ==
    /\ state[n].phase = Phase1_tag
    /\ Cardinality(state[n].promises_rcvd) >= QuorumSize
    /\ v \in NonZeroValues
    /\ LET chosen_val == IF state[n].highest_accepted_bal > 0
                          THEN state[n].highest_accepted_val
                          ELSE v
       IN  /\ state' = [state EXCEPT ![n] =
               [@ EXCEPT !.proposed_val = chosen_val,
                          !.phase = Phase2_tag,
                          !.accepts_rcvd = {}]]
           /\ msgs' = msgs \cup {Msg2a(state[n].proposer_bal, chosen_val)}

\* Send2b: acceptor n accepts a 2a message for ballot b, value v.
\* Corresponds to Send2b(s, s_, c, b, v) in generated spec.
Send2b(n, b, v) ==
    /\ Msg2a(b, v) \in msgs
    /\ b >= state[n].promised_bal
    /\ state' = [state EXCEPT ![n] =
        [@ EXCEPT !.promised_bal = b,
                   !.accepted_bal = b,
                   !.accepted_val = v]]
    /\ msgs' = msgs \cup {Msg2b(n, b, v)}

\* RecvAccepted: proposer n receives a 2b from acceptor a.
\* Corresponds to RecvAccepted(s, s_, c, a) in generated spec.
RecvAccepted(n, a) ==
    /\ state[n].phase = Phase2_tag
    /\ a \in Nodes
    /\ ~(a \in state[n].accepts_rcvd)
    /\ Msg2b(a, state[n].proposer_bal, state[n].proposed_val) \in msgs
    /\ state' = [state EXCEPT ![n] =
        [@ EXCEPT !.accepts_rcvd = state[n].accepts_rcvd \cup {a}]]
    /\ UNCHANGED msgs

\* Learn: proposer n has enough accepts, decides.
\* Corresponds to Learn(s, s_, c) in generated spec.
Learn(n) ==
    /\ state[n].phase = Phase2_tag
    /\ Cardinality(state[n].accepts_rcvd) >= QuorumSize
    /\ state' = [state EXCEPT ![n] =
        [@ EXCEPT !.phase = Decided_tag,
                   !.decided_val = state[n].proposed_val]]
    /\ UNCHANGED msgs

\* --- Next state relation ---

StateNext ==
    \/ \E n \in Nodes : Send1a(n)
    \/ \E n \in Nodes, b \in NonZeroBallots : Send1b(n, b)
    \/ \E n \in Nodes, m \in msgs : RecvPromise(n, m)
    \/ \E n \in Nodes, v \in NonZeroValues : Send2a(n, v)
    \/ \E n \in Nodes, b \in NonZeroBallots, v \in NonZeroValues : Send2b(n, b, v)
    \/ \E n \in Nodes, a \in Nodes : RecvAccepted(n, a)
    \/ \E n \in Nodes : Learn(n)

\* --- Specification ---

Spec == StateInit /\ [][StateNext]_vars

\* --- Safety Invariants ---

\* Agreement: If two nodes have decided, they decided the same value.
\* This is the fundamental Paxos safety property.
Agreement ==
    \A n1, n2 \in Nodes :
        (state[n1].phase = Decided_tag /\ state[n2].phase = Decided_tag)
        => state[n1].decided_val = state[n2].decided_val

\* Validity: A decided value must have been proposed in some 2a message.
Validity ==
    \A n \in Nodes :
        state[n].phase = Decided_tag =>
            \E b \in NonZeroBallots :
                Msg2a(b, state[n].decided_val) \in msgs

\* Acceptor monotonicity: accepted_bal <= promised_bal always
AcceptorMonotonicity ==
    \A n \in Nodes :
        state[n].accepted_bal <= state[n].promised_bal

\* Decided value equals proposed value for the deciding node
DecidedEqualsProposed ==
    \A n \in Nodes :
        state[n].phase = Decided_tag =>
            state[n].decided_val = state[n].proposed_val

====
