// Mode annotations for Single-Decree Paxos protocol
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module Paxos::paxos {
    // Initialize protocol state from constants
    // s (output): initialized state
    // c (input): protocol constants
    LInit(-, +);

    // Phase 1a: Proposer starts new round with ballot b
    // s (input): current state
    // s_ (output): new state
    // c (input): constants
    // b (input): ballot number
    LSend1a(+, -, +, +);

    // Phase 1b: Acceptor responds to prepare with ballot b
    // s (input): current state
    // s_ (output): new state
    // c (input): constants
    // b (input): ballot number
    LSend1b(+, -, +, +);

    // Proposer receives promise from acceptor a
    // s (input): current state
    // s_ (output): new state
    // c (input): constants
    // a (input): acceptor identifier
    // a_accepted_bal (input): acceptor's last accepted ballot
    // a_accepted_val (input): acceptor's last accepted value
    LRecvPromise(+, -, +, +, +, +);

    // Phase 2a: Proposer sends accept (quorum reached)
    // s (input): current state
    // s_ (output): new state
    // c (input): constants
    // v (input): proposed value (used if no prior accepted value)
    LSend2a(+, -, +, +);

    // Phase 2b: Acceptor accepts ballot b with value v
    // s (input): current state
    // s_ (output): new state
    // c (input): constants
    // b (input): ballot number
    // v (input): accepted value
    LSend2b(+, -, +, +, +);

    // Proposer receives Accept acknowledgment from acceptor a
    // s (input): current state
    // s_ (output): new state
    // c (input): constants
    // a (input): acceptor identifier
    LRecvAccepted(+, -, +, +);

    // Learn: quorum of accepts, value is decided
    // s (input): current state
    // s_ (output): new state
    // c (input): constants
    LLearn(+, -, +);

    // LNext is not transpiled - contains existential quantifiers
}
