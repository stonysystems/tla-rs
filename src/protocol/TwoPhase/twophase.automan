// Mode annotations for Two-Phase Commit protocol
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module TwoPhase::twophase {
    // Initialize protocol state from constants
    // s (output): initialized state
    // c (input): protocol constants
    LInit(-, +);

    // TM broadcasts Prepare to all RMs
    // s (input): current state
    // s_ (output): new state
    // c (input): constants
    // sent_packets (output): messages to send
    LTMSendPrepare(+, -, +, -);

    // RM receives Prepare and transitions Working -> Prepared
    // s (input): current state
    // s_ (output): new state
    // c (input): constants
    // rm (input): resource manager identifier
    // sent_packets (output): messages to send
    LRMReceivePrepare(+, -, +, +, -);

    // RM unilaterally aborts (before prepare)
    // s (input): current state
    // s_ (output): new state
    // c (input): constants
    // rm (input): resource manager identifier
    // sent_packets (output): messages to send
    LRMAbort(+, -, +, +, -);

    // TM receives Prepared from resource manager r
    // s (input): current state
    // s_ (output): new state
    // c (input): constants
    // r (input): resource manager identifier
    // sent_packets (output): messages to send
    LTMRcvPrepared(+, -, +, +, -);

    // TM commits (all RMs prepared) and broadcasts Commit
    // s (input): current state
    // s_ (output): new state
    // c (input): constants
    // sent_packets (output): messages to send
    LTMSendCommit(+, -, +, -);

    // TM aborts and broadcasts Abort
    // s (input): current state
    // s_ (output): new state
    // c (input): constants
    // sent_packets (output): messages to send
    LTMSendAbort(+, -, +, -);

    // RM receives Commit and transitions Prepared -> Committed
    // s (input): current state
    // s_ (output): new state
    // c (input): constants
    // rm (input): resource manager identifier
    // sent_packets (output): messages to send
    LRMReceiveCommit(+, -, +, +, -);

    // RM receives Abort and transitions to Aborted
    // s (input): current state
    // s_ (output): new state
    // c (input): constants
    // rm (input): resource manager identifier
    // sent_packets (output): messages to send
    LRMReceiveAbort(+, -, +, +, -);

    // Next-state relation (skip: contains existential quantifiers)
    // LNext is not transpiled - dispatch handled at a higher level
}
