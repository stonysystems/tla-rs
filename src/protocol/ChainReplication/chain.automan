// Mode annotations for Chain Replication protocol
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module ChainReplication::chain {
    // Initialize node state from constants
    // s (output): initialized state
    // c (input): protocol constants
    LInit(-, +);

    // Head receives a client write request
    // s (input): current state
    // s_ (output): new state
    // c (input): constants
    // value (input): value to write
    // sent_packets (output): messages sent
    LHeadReceiveWrite(+, -, +, +, -);

    // Head or middle node forwards value to successor
    // s (input): current state
    // s_ (output): new state
    // c (input): constants
    // value (input): value to forward
    // sent_packets (output): messages sent
    LForwardToSuccessor(+, -, +, +, -);

    // Node receives an update from predecessor
    // s (input): current state
    // s_ (output): new state
    // c (input): constants
    // value (input): value received from predecessor
    // sent_packets (output): messages sent
    LReceiveUpdate(+, -, +, +, -);

    // Tail commits a value
    // s (input): current state
    // s_ (output): new state
    // c (input): constants
    // value (input): value to commit
    // sent_packets (output): messages sent
    LTailCommit(+, -, +, +, -);

    // Node receives an ack from successor
    // s (input): current state
    // s_ (output): new state
    // c (input): constants
    // value (input): value being acknowledged
    // sent_packets (output): messages sent
    LReceiveAck(+, -, +, +, -);

    // Client reads current committed value (no state change)
    // s (input): current state
    // s_ (output): new state (same as s)
    // c (input): constants
    // sent_packets (output): messages sent
    LClientRead(+, -, +, -);

    // A node fails (crashes)
    // s (input): current state
    // s_ (output): new state
    // c (input): constants
    // sent_packets (output): messages sent
    LNodeFail(+, -, +, -);

    // Reconfigure: adjust chain links after failure
    // sent_packets (output): messages sent
    LReconfigure(+, -, +, +, +, +, +, -);
    // LNext is not transpiled (contains existential quantifiers)
}
