// Mode annotations for Raft Consensus protocol
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module Raft::raft {
    LInit(-, +);
    LTimeout(+, -, +, -);
    LGrantVote(+, -, +, +, +, +, +, -);
    LReceiveVoteGranted(+, -, +, +, +, +, -);
    LBecomeLeader(+, -, +, -);
    LClientRequest(+, -, +, +, -);
    LSendAppendEntries(+, -, +, +, +, +, +, +, -);
    LFollowerAppendEntries(+, -, +, +, +, +, +, +, +, +, -);
    LHandleAppendResponse(+, -, +, +, +, +, +, +, +, -);
    LHandleAppendReject(+, -, +, +, +, +, +, +, -);
    LAdvanceCommitIndex(+, -, +, +, -);
    LStepDown(+, -, +, +, -);
    // LNext not transpiled (contains existential quantifiers)
}
