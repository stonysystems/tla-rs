// Mode annotations for Raft Consensus protocol
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module Raft::raft {
    LInit(-, +);
    LTimeout(+, -, +);
    LGrantVote(+, -, +, +, +, +, +);
    LReceiveVoteGranted(+, -, +, +);
    LBecomeLeader(+, -, +);
    LClientRequest(+, -, +, +);
    LSendAppendEntries(+, -, +, +, +, +, +, +);
    // LFollowerAppendEntries not transpiled (complex Seq::push in inline if/else with struct literals)
    // LHandleAppendResponse not transpiled (uses Map::insert with as u64 casts)
    // LHandleAppendReject not transpiled (uses Map::dom().contains with conditional update)
    LAdvanceCommitIndex(+, -, +, +);
    LStepDown(+, -, +, +);
    // LNext not transpiled (contains existential quantifiers)
}
