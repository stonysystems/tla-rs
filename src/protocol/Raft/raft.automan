// Mode annotations for Raft Consensus protocol
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module Raft::raft {
    // Core state functions
    LInit(-, +);

    // Atomic actions (transpiled to verified exec functions)
    LTimeout(+, -, +, -);
    LGrantVote(+, -, +, +, +, +, +, -);
    LReceiveVoteGranted(+, -, +, +, +, +, -);
    LBecomeLeader(+, -, +, -);
    LClientRequest(+, -, +, +, -);
    LSendAppendEntries(+, -, +, +, +, +, +, +, -);
    LFollowerAppendEntries(+, -, +, +, +, +, +, +, +, +, -);
    LHandleAppendResponse(+, -, +, +, +, +, +, +, +, -);
    LHandleAppendReject(+, -, +, +, +, +, +, +, -);
    LAdvanceCommitIndex(+, -, +, +, -);
    LStepDown(+, -, +, +, -);

    // Spec helpers (value-returning functions)
    helper step_down_if_needed(+, +) -> LState;
    helper log_up_to_date(+, +, +) -> bool;

    // Composite message handlers (Phase 29 — transpiler-generated)
    LHandleRequestVoteMsg(+, -, +, +, +, +, +, -);
    LHandleAppendEntriesMsg(+, -, +, +, +, +, +, +, +, +, -);
    // LHandleVoteResponseMsg(+, -, +, +, +, +, -);
    // LHandleAppendResponseMsg(+, -, +, +, +, +, +, -);
    // LTryAdvanceCommitIndex(+, -, +, +, -);
    // LHandleMessage(+, -, +, +, -);
    // LNext not transpiled (contains existential quantifiers)
}
