// Mode annotations for RSL Executor predicates
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module RSL::executor {
    // Initialization predicate: creates a new executor from constants
    // s (output): the initialized executor state
    // c (input): the replica constants
    LExecutorInit(-, +);

    // Get decision for an operation
    // s (input): current executor state
    // s_ (output): new executor state with decision
    // bal (input): ballot of the decision
    // opn (input): operation number
    // v (input): request batch value
    LExecutorGetDecision(+, -, +, +, +);

    // Execute the outstanding operation
    // s (input): current executor state
    // s_ (output): new executor state after execution
    // sent_packets (output): reply packets to send
    LExecutorExecute(+, -, -);

    // Process app state supply message (state transfer)
    // s (input): current executor state
    // s_ (output): new executor state with transferred state
    // inp (input): incoming app state supply packet
    LExecutorProcessAppStateSupply(+, -, +);

    // Process app state request message
    // s (input): current executor state
    // s_ (output): new executor state (unchanged)
    // inp (input): incoming app state request packet
    // sent_packets (output): app state supply response packets
    LExecutorProcessAppStateRequest(+, -, +, -);

    // Process starting phase 2 message
    // s (input): current executor state
    // s_ (output): new executor state (unchanged)
    // inp (input): incoming StartingPhase2 packet
    // sent_packets (output): app state request broadcast packets
    LExecutorProcessStartingPhase2(+, -, +, -);

    // Process request from cache (reply with cached response)
    // s (input): current executor state
    // inp (input): incoming request packet
    // sent_packets (output): cached reply packets
    LExecutorProcessRequest(+, +, -);

    // Helper: Get reply packets from requests and replies
    // Pure function (all inputs, returns output)
    GetPacketsFromReplies(+, +, +);

    // Helper: Build client-to-reply cache from replies
    // Pure function (input, returns output)
    LClientsInReplies(+);

    // Helper: Check if all replies are of reply type
    // Pure predicate (all inputs)
    RepliesAreReplyType(+);

    // Helper: Update reply cache with new replies
    // Pure predicate (all inputs)
    UpdateNewCache(+, +, +);
}
