// Mode annotations for RSL Learner predicates
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module RSL::learner {
    // Initialization predicate: creates a new learner from constants
    // l (output): the initialized learner state
    // c (input): the replica constants
    LLearnerInit(-, +);

    // Process 2b message (Phase 2b of Paxos - learn)
    // s (input): current learner state
    // s_ (output): new learner state after processing
    // packet (input): incoming 2b message packet
    LLearnerProcess2b(+, -, +);

    // Forget a specific decision at operation number
    // s (input): current learner state
    // s_ (output): new learner state after removal
    // opn (input): operation number to forget
    LLearnerForgetDecision(+, -, +);

    // Forget all operations before a given point
    // s (input): current learner state
    // s_ (output): new learner state after cleanup
    // ops_complete (input): cutoff operation number
    LLearnerForgetOperationsBefore(+, -, +);
}
