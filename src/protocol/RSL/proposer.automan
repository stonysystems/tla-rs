// Mode annotations for RSL Proposer predicates
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module RSL::proposer {
    // Initialization predicate: creates a new proposer from constants
    // s (output): the initialized proposer state
    // c (input): the replica constants
    LProposerInit(-, +);

    // Process incoming request from client
    // s (input): current proposer state
    // s_ (output): new proposer state
    // packet (input): incoming request packet
    LProposerProcessRequest(+, -, +);

    // Maybe enter new view and send 1a messages
    // s (input): current proposer state
    // s_ (output): new proposer state
    // sent_packets (output): outgoing 1a message packets
    LProposerMaybeEnterNewViewAndSend1a(+, -, -);

    // Process 1b message (response to our 1a)
    // s (input): current proposer state
    // s_ (output): new proposer state
    // p (input): incoming 1b message packet
    LProposerProcess1b(+, -, +);

    // Maybe enter phase 2 after receiving quorum of 1b messages
    // s (input): current proposer state
    // s_ (output): new proposer state
    // log_truncation_point (input): current log truncation point
    // sent_packets (output): outgoing StartingPhase2 message packets
    LProposerMaybeEnterPhase2(+, -, +, -);

    // Nominate a new value and send 2a
    // s (input): current proposer state
    // s_ (output): new proposer state
    // clock (input): current time
    // log_truncation_point (input): current log truncation point
    // sent_packets (output): outgoing 2a message packets
    LProposerNominateNewValueAndSend2a(+, -, +, +, -);

    // Nominate an old value (from previous ballot) and send 2a
    // s (input): current proposer state
    // s_ (output): new proposer state
    // log_truncation_point (input): current log truncation point
    // sent_packets (output): outgoing 2a message packets
    LProposerNominateOldValueAndSend2a(+, -, +, -);

    // Maybe nominate value and send 2a (dispatch function)
    // s (input): current proposer state
    // s_ (output): new proposer state
    // clock (input): current time
    // log_truncation_point (input): current log truncation point
    // sent_packets (output): outgoing 2a message packets
    LProposerMaybeNominateValueAndSend2a(+, -, +, +, -);

    // Process heartbeat message
    // s (input): current proposer state
    // s_ (output): new proposer state
    // p (input): incoming heartbeat packet
    // clock (input): current time
    LProposerProcessHeartbeat(+, -, +, +);

    // Check for view timeout
    // s (input): current proposer state
    // s_ (output): new proposer state
    // clock (input): current time
    LProposerCheckForViewTimeout(+, -, +);

    // Check for quorum of view suspicions
    // s (input): current proposer state
    // s_ (output): new proposer state
    // clock (input): current time
    LProposerCheckForQuorumOfViewSuspicions(+, -, +);

    // Reset view timer due to execution
    // s (input): current proposer state
    // s_ (output): new proposer state
    // val (input): executed request batch
    LProposerResetViewTimerDueToExecution(+, -, +);

    // Helper predicates (pure - all inputs)
    LIsAfterLogTruncationPoint(+, +);
    LSetOfMessage1b(+);
    LSetOfMessage1bAboutBallot(+, +);
    LExistVotesHasProposalLargeThanOpn(+, +);
    LExistsAcceptorHasProposalLargeThanOpn(+, +);
    LAllAcceptorsHadNoProposal(+, +);
    Lmax_balInS(+, +, +);
    LExistsBallotInS(+, +, +, +);
    LValIsHighestNumberedProposalAtBallot(+, +, +, +);
    LValIsHighestNumberedProposal(+, +, +);
    LProposerCanNominateUsingOperationNumber(+, +, +);
}
