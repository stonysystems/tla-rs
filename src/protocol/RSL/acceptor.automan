// Mode annotations for RSL Acceptor predicates
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module RSL::acceptor {
    // Initialization predicate: creates a new acceptor from constants
    // a (output): the initialized acceptor state
    // c (input): the replica constants
    LAcceptorInit(-, +);

    // Process 1a message (Phase 1a of Paxos)
    // s (input): current acceptor state
    // s_ (output): new acceptor state after processing
    // inp (input): incoming 1a message packet
    // sent_packets (output): outgoing 1b message packets
    LAcceptorProcess1a(+, -, +, -);

    // Process 2a message (Phase 2a of Paxos - accept)
    // s (input): current acceptor state
    // s_ (output): new acceptor state after processing
    // inp (input): incoming 2a message packet
    // sent_packets (output): outgoing 2b message packets (broadcast)
    LAcceptorProcess2a(+, -, +, -);

    // Process heartbeat message
    // s (input): current acceptor state
    // s_ (output): new acceptor state after processing
    // inp (input): incoming heartbeat packet
    LAcceptorProcessHeartbeat(+, -, +);

    // Truncate log at given operation number
    // s (input): current acceptor state
    // s_ (output): new acceptor state after truncation
    // opn (input): operation number to truncate at
    LAcceptorTruncateLog(+, -, +);

    // Helper: Remove votes before log truncation point
    // votes (input): current votes map
    // votes_ (output): filtered votes map
    // log_truncation_point (input): cutoff operation number
    RemoveVotesBeforeLogTruncationPoint(+, -, +);

    // Helper: Add a new vote and remove old ones
    // votes (input): current votes map
    // votes_ (output): updated votes map
    // new_opn (input): operation number for new vote
    // new_vote (input): the new vote to add
    // log_truncation_point (input): cutoff operation number
    LAddVoteAndRemoveOldOnes(+, -, +, +, +);

    // Pure predicate: no inputs/outputs, just a boolean check
    // IsLogTruncationPointValid is a pure predicate (all inputs)
    IsLogTruncationPointValid(+, +, +);
}
