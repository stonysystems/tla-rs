module EPaxos::epaxos {
    LInit(-, +);
    LPropose(+, -, +, +);
    LSendPreAcceptOk(+, -, +, +, +);
    LReceivePreAcceptOk(+, -, +);
    LFastCommit(+, -, +);
    LStartAccept(+, -, +);
    LSendAcceptOk(+, -, +);
    LReceiveAcceptOk(+, -, +);
    LSlowCommit(+, -, +);
    LExecute(+, -, +);
    LRecover(+, -, +, +);
    LNewInstance(+, -, +);
    // LNext not transpiled (contains existential quantifiers)
}
