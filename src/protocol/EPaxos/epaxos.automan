module EPaxos::epaxos {
    LInit(-, +);
    LPropose(+, -, +, +);
    LSendPreAcceptOk(+, -, +, +, +);
    LReceivePreAcceptOk(+, -, +);
    // LFastCommit not transpiled (uses Set::len() for quorum check)
    // LStartAccept not transpiled (uses Set::len() for quorum check)
    LSendAcceptOk(+, -, +);
    LReceiveAcceptOk(+, -, +);
    // LSlowCommit not transpiled (uses Set::len() for quorum check)
    LExecute(+, -, +);
    LRecover(+, -, +, +);
    LNewInstance(+, -, +);
    // LNext not transpiled (contains existential quantifiers)
}
