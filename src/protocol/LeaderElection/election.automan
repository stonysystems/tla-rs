// Mode annotations for Bully Leader Election protocol
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module LeaderElection::election {
    // Initialize protocol state from constants
    LInit(-, +);

    // s, s_, c, node, sent_packets
    LDetectFailure(+, -, +, +, -);

    // s, s_, c, node, sent_packets
    LStartElection(+, -, +, +, -);

    // s, s_, c, node, sender, sent_packets
    LSendAnswer(+, -, +, +, +, -);

    // s, s_, c, node, responder, sent_packets
    LReceiveAnswer(+, -, +, +, +, -);

    // s, s_, c, node, sent_packets
    LSendCoordinator(+, -, +, +, -);

    // s, s_, c, node, leader, sent_packets
    LReceiveCoordinator(+, -, +, +, +, -);

    // s, s_, c, node, sent_packets
    LNodeFail(+, -, +, +, -);

    // LNext is not transpiled (contains existential quantifiers)
}
