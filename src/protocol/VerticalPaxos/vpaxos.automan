// Mode annotations for Vertical Paxos (Reconfigurable Paxos) protocol
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module VerticalPaxos::vpaxos {
    LInit(-, +);
    LPrepare(+, -, +, +);
    LSendPromise(+, -, +);
    LReceivePromise(+, -, +, +);
    LAccept(+, -, +, +, +);
    LReceiveAccepted(+, -, +, +);
    LReconfigure(+, -, +);
    LWitnessSync(+, -, +, +);
    LSync(+, -, +, +, +);
    LDeactivate(+, -, +);
    // LCommit not transpiled (uses Set::len() for quorum check)
    // LNext not transpiled (contains existential quantifiers)
}
