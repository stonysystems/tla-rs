// Mode annotations for Vertical Paxos (Reconfigurable Paxos) protocol
// Format: FunctionName(mode1, mode2, ...) where + = input, - = output

module VerticalPaxos::vpaxos {
    // Initialize protocol state from constants
    LInit(-, +);

    // Phase 1a: Prepare with ballot b
    LPrepare(+, -, +, +);

    // Phase 2a/2b: Accept value v at ballot b
    LAccept(+, -, +, +, +);

    // Reconfigure: move to new configuration
    LReconfigure(+, -, +);

    // Sync: transfer state to new config member
    LSync(+, -, +, +, +);

    // Deactivate: leave active set
    LDeactivate(+, -, +);

    // LNext: contains existential quantifiers, not transpiled
}
