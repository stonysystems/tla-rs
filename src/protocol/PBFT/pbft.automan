module PBFT::pbft {
    LInit(-, +);
    // s, s_, c, digest, sent_packets
    LPrePrepare(+, -, +, +, -);
    // s, s_, c, view, seq, digest, sent_packets
    LReceivePrePrepare(+, -, +, +, +, +, -);
    // s, s_, c, sender, sent_packets
    LReceivePrepare(+, -, +, +, -);
    // s, s_, c, sender, sent_packets
    LReceiveCommit(+, -, +, +, -);
    // s, s_, c, digest, sent_packets
    LCheckpoint(+, -, +, +, -);
    // s, s_, c, sent_packets
    LViewChange(+, -, +, -);
    // s, s_, c, sent_packets
    LNewRound(+, -, +, -);
    // s, s_, c, sent_packets
    LEnterCommit(+, -, +, -);
    // s, s_, c, sent_packets
    LExecuteReply(+, -, +, -);
    // LNext not transpiled (contains existential quantifiers)
}
